<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalhes do Livro"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/txtTituloDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título: "
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtAutorDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autor: "
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtEditoraDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editora: "
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtAnoDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ano de Publicação: "
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Onde ou como o livro foi encontrado?"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerSituacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:entries="@array/situacoes_livro"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status de Leitura:"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <RadioGroup
            android:id="@+id/radioGroupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/rbQueroLer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quero ler"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbLendo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lendo"
                android:layout_marginStart="12dp"/>

            <RadioButton
                android:id="@+id/rbConcluido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Concluído"
                android:layout_marginStart="12dp"/>
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Observação pessoal:"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/edtObservacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Adicione uma observação pessoal sobre o livro"
            android:inputType="textMultiLine"
            android:lines="3"
            android:gravity="top"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSalvarCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar no Aplicativo"
            android:onClick="salvarDadosLivro"/>

    </LinearLayout>
</ScrollView>